# ─── GitHub Integration ───────────────────────────────────────────────────────
# Personal Access Token (classic) with scopes: repo, workflow, gist
# Generated at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# ─── AI Integration ───────────────────────────────────────────────────────────
# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── Application Settings ─────────────────────────────────────────────────────
# Default directory for new projects
DEFAULT_PROJECTS_DIR=~/Projects

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# UI theme: light | dark | system
APP_THEME=system

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Enable experimental AI suggestions
FEATURE_AI_SUGGESTIONS=true

# Enable GitHub repo analysis for structure suggestions
FEATURE_REPO_ANALYSIS=true
