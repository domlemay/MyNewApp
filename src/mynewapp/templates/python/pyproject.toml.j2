[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.11"
{% if framework == 'fastapi' %}
dependencies = [
    "fastapi>=0.110.0",
    "uvicorn[standard]>=0.29.0",
    "pydantic>=2.6.0",
    {% if database.engine == 'PostgreSQL' %}"sqlalchemy>=2.0.0",
    "asyncpg>=0.29.0",
    "alembic>=1.13.0",{% endif %}
]
{% elif framework == 'django' %}
dependencies = [
    "django>=5.0.0",
    {% if database.engine == 'PostgreSQL' %}"psycopg2-binary>=2.9.0",{% endif %}
]
{% elif framework == 'flask' %}
dependencies = [
    "flask>=3.0.0",
    "flask-sqlalchemy>=3.1.0",
]
{% elif framework == 'pyqt6' %}
dependencies = [
    "PyQt6>=6.6.0",
    "loguru>=0.7.2",
]
{% else %}
dependencies = []
{% endif %}

[project.optional-dependencies]
dev = [
    "pytest>=7.4.0",
    "pytest-cov>=4.1.0",
    "ruff>=0.3.0",
    "mypy>=1.8.0",
    "pre-commit>=3.6.0",
]

[project.scripts]
{{ name | replace('-', '_') }} = "{{ name | replace('-', '_') }}.main:main"

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--cov=src --cov-report=term-missing -v"
