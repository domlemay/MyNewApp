# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME={{ name }}
APP_ENV=development
LOG_LEVEL=INFO

{% if database.engine %}
# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL={{ database.engine | lower }}://user:password@localhost:5432/{{ name | replace('-','_') }}
{% endif %}

{% if auth.provider %}
# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret
JWT_EXPIRE_MINUTES=60
{% endif %}

{% if ai_tools.enabled %}
# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
{% endif %}
